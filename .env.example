# ─────────────────────────────────────────────────────────────
# Locking Protocol Animation — environment configuration
# Copy this file to ".env" and fill in the values you need.
# ".env" is git-ignored — never commit it.
# ─────────────────────────────────────────────────────────────

# Port the HTTP server listens on
PORT=3000

# Secret used to sign the session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED when NODE_ENV=production (the server refuses to start without it).
SESSION_SECRET=change-me-to-a-long-random-string-at-least-16-chars

# Session lifetime in days
SESSION_MAX_AGE=30

# bcrypt cost factor (higher = slower and stronger)
BCRYPT_ROUNDS=12

# Set to "production" to enable secure (HTTPS-only) session cookies.
# The server will refuse to start in production without a SESSION_SECRET.
NODE_ENV=development

# Location of the SQLite database file.
# Point this at a persistent volume in production, e.g. DB_PATH=/data/database.db
# DB_PATH=./database.db

# API key for the AI Tutor (Groq). Without it the tutor answers with a
# built-in rule-based fallback.
# GROQ_API_KEY=your_key_here

# Extra origins allowed to call the API with credentials (comma separated).
# Only needed when the front end is served from a different host than the API.
# ALLOWED_ORIGINS=https://example.com,https://www.example.com
